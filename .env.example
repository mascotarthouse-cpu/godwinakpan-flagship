# Postgres (Netlify DB / Neon). Leave empty to run on built-in sample content.
DATABASE_URL=
# Admin login for /admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Long random string used to sign the admin session cookie
AUTH_SECRET=
# Secret for the scheduled Medium sync
CRON_SECRET=
# Optional: email notifications for new inquiries (resend.com)
RESEND_API_KEY=
INQUIRY_TO=godwin-akpan@outlook.com
# Domain forwarding: the domain everyone ends up on
PRIMARY_HOST=www.godwinakpan.si
SITE_URL=https://www.godwinakpan.si

# Ask Ifiok (optional). Any OpenAI-compatible API. Free options:
#   Groq:   AI_API_KEY from console.groq.com (default base URL and model below)
#   Gemini: AI_API_KEY from aistudio.google.com, AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai, AI_MODEL=gemini-2.0-flash
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.3-70b-versatile
